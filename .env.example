# Used by npm run api locally. In Azure, set these under Static Web App environment variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
FRONTEND_URL=http://localhost:5000
API_PORT=8787
TOKEN_ENCRYPTION_KEY=
IRONINBOX_STORAGE_CONNECTION_STRING=
IRONINBOX_STORAGE_CONTAINER=ironinbox

# Microsoft app registration: Web platform, personal + organizational accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/outlook/callback
